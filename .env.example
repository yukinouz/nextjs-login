# JWT（ログイン Cookie）の署名用。npx auth secret で生成するか、32バイトのランダム文字列を生成する
AUTH_SECRET=YOUR_AUTH_SECRET_CREATED_BY_NPX_AUTH_SECRET
# ローカル開発でホスト（localhost）を信頼する。秘密情報ではない
AUTH_TRUST_HOST=true

# Google OAuth のクライアント ID / シークレット。値は .env.local にだけ書く
AUTH_GOOGLE_ID=YOUR_AUTH_GOOGLE_ID
AUTH_GOOGLE_SECRET=YOUR_AUTH_GOOGLE_SECRET
